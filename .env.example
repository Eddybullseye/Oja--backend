# Supabase Database URLs
# Supabase provides two connection strings in its Database Settings -> Connection String -> URI.

# 1. Transaction Pooler (Used for typical connections)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# 2. Session / Direct connection (Used by Prisma for migrations)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DIRECT_URL=
